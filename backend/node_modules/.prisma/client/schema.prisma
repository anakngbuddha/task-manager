generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  name                     String?
  avatar                   String?
  image                    String?
  emailVerified            Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  status                   UserStatus                @default(ONLINE)
  lastSeenAt               DateTime                  @default(now())
  tasks                    Task[]
  timeLogs                 TimeLog[]
  projects                 ProjectMember[]
  accounts                 Account[]
  sessions                 Session[]
  createdInvites           ProjectInvite[]           @relation("ProjectInviteCreatedBy")
  acceptedInvites          ProjectInvite[]           @relation("ProjectInviteAcceptedBy")
  taskComments             TaskComment[]
  projectMessages          ProjectMessage[]
  directMessagesSent       ProjectDirectMessage[]    @relation("DirectMessageSender")
  directMessagesReceived   ProjectDirectMessage[]    @relation("DirectMessageRecipient")
  activityEvents           ActivityEvent[]           @relation("ActivityActor")
  notifications            Notification[]
  projectChatReads         ProjectChatReadState[]
  directChatReads          DirectChatReadState[]
  dashboardLayouts         DashboardLayout[]
  githubInstallations      GithubInstallation[]
  createdSchedules         Schedule[]
  scheduleNotificationLogs ScheduleNotificationLog[]
  analyticsEvents          AnalyticsEvent[]
  role                     String                    @default("user")
  fileNodes                FileNode[]
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?   @db.Text
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.VarChar(512)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model Project {
  id                      String                          @id @default(cuid())
  name                    String
  status                  ProjectStatus                   @default(ACTIVE)
  boardColumns            Json                            @default("[\"TODO\", \"IN_PROGRESS\", \"IN_REVIEW\", \"DONE\", \"READY\"]")
  githubStatusMap         Json?
  createdAt               DateTime                        @default(now())
  tasks                   Task[]
  sprints                 Sprint[]
  members                 ProjectMember[]
  invites                 ProjectInvite[]
  messages                ProjectMessage[]
  directMessages          ProjectDirectMessage[]
  activityEvents          ActivityEvent[]
  notifications           Notification[]
  projectChatReads        ProjectChatReadState[]
  directChatReads         DirectChatReadState[]
  dashboardLayouts        DashboardLayout[]
  githubInstallations     GithubInstallation[]
  projectRepositories     ProjectRepository[]
  repoEvents              RepoEvent[]
  schedules               Schedule[]
  dependencyDiagramLayout ProjectDependencyDiagramLayout?
}

model ProjectDependencyDiagramLayout {
  id        String   @id @default(cuid())
  projectId String   @unique
  layout    Json
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model Task {
  id                       String                    @id @default(cuid())
  title                    String
  description              String?
  status                   String                    @default("TODO")
  priority                 Priority                  @default(MEDIUM)
  projectId                String
  assigneeId               String?
  sprintId                 String?
  parentId                 String?
  startDate                DateTime?
  deadline                 DateTime?
  completedAt              DateTime?
  githubPrUrl              String?
  deadlineReminderSent     Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  project                  Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee                 User?                     @relation(fields: [assigneeId], references: [id])
  sprint                   Sprint?                   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  parent                   Task?                     @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks                 Task[]                    @relation("TaskSubtasks")
  timeLogs                 TimeLog[]
  comments                 TaskComment[]
  blockingTasks            TaskDependency[]          @relation("BlockingTasks")
  blockedByTasks           TaskDependency[]          @relation("BlockedTasks")
  scheduleNotificationLogs ScheduleNotificationLog[]
  githubLinks              TaskGithubLink[]
  tags                     TaskTag[]
  attachments              TaskAttachment[]

  @@index([projectId])
  @@index([assigneeId])
}

model TaskDependency {
  id             String   @id @default(cuid())
  blockingTaskId String
  blockedTaskId  String
  type           String   @default("BLOCKS")
  createdAt      DateTime @default(now())

  blockingTask Task @relation("BlockingTasks", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask  Task @relation("BlockedTasks", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@unique([blockingTaskId, blockedTaskId])
  @@index([blockedTaskId])
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(30)
  color     String    @default("#6366f1")
  createdAt DateTime  @default(now())
  tasks     TaskTag[]

  @@index([name])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
}

model ProjectInvite {
  id           String   @id @default(cuid())
  code         String   @unique
  projectId    String
  createdById  String
  acceptedById String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("ProjectInviteCreatedBy", fields: [createdById], references: [id])
  acceptedBy User?   @relation("ProjectInviteAcceptedBy", fields: [acceptedById], references: [id])
}

model ProjectMember {
  userId    String
  projectId String
  role      Role    @default(MEMBER)
  user      User    @relation(fields: [userId], references: [id])
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  parentId  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task    Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id])
  parent  TaskComment?  @relation("TaskCommentThread", fields: [parentId], references: [id])
  replies TaskComment[] @relation("TaskCommentThread")

  @@index([taskId])
}

model ProjectMessage {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  content   String
  fileUrl   String?
  fileName  String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId, createdAt])
}

model ProjectDirectMessage {
  id          String   @id @default(cuid())
  projectId   String
  senderId    String
  recipientId String
  content     String
  fileUrl     String?
  fileName    String?
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender    User    @relation("DirectMessageSender", fields: [senderId], references: [id])
  recipient User    @relation("DirectMessageRecipient", fields: [recipientId], references: [id])

  @@index([projectId, senderId, createdAt])
  @@index([projectId, recipientId, createdAt])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  projectId  String
  actorId    String
  type       String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User    @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  projectId String?
  type      String
  title     String
  body      String?
  href      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([projectId, createdAt])
}

model ProjectChatReadState {
  projectId  String
  userId     String
  lastReadAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model DirectChatReadState {
  projectId   String
  userId      String
  otherUserId String
  lastReadAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId, otherUserId])
  @@index([projectId, otherUserId, userId])
}

model Sprint {
  id          String       @id @default(cuid())
  projectId   String
  name        String
  goal        String?      @db.Text
  startDate   DateTime?
  endDate     DateTime?
  status      SprintStatus @default(PLANNING)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([projectId, status])
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum UserStatus {
  ONLINE
  WORKING
  BUSY
  AWAY
  IN_MEETING
  OFFLINE
}

enum Role {
  MASTER_ADMIN
  PROJECT_MANAGER
  MEMBER
}

model TimeLog {
  id              String   @id @default(cuid())
  taskId          String
  userId          String
  durationMinutes Int
  note            String?
  loggedAt        DateTime
  createdAt       DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, loggedAt])
  @@index([userId, loggedAt])
}

model DashboardLayout {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  layout    Json
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId, updatedAt])
  @@map("dashboard_layouts")
}

model GithubInstallation {
  id             String   @id @default(cuid())
  installationId Int      @unique
  userId         String
  projectId      String?
  repos          Json?
  createdAt      DateTime @default(now())

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositories GithubRepository[]
}

model GithubRepository {
  id             String  @id @default(cuid())
  installationId String
  repoFullName   String
  repoId         Int
  isActive       Boolean @default(true)

  installation        GithubInstallation  @relation(fields: [installationId], references: [id], onDelete: Cascade)
  projectRepositories ProjectRepository[]
  repoEvents          RepoEvent[]

  @@unique([installationId, repoFullName])
}

model ProjectRepository {
  id        String   @id @default(cuid())
  projectId String
  repoId    String
  createdAt DateTime @default(now())

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo    GithubRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([projectId, repoId])
  @@index([projectId])
}

// ─── Project-level GitHub event log ───────────────────────────

model RepoEvent {
  id               String   @id @default(cuid())
  projectId        String
  repoId           String
  eventType        String
  branch           String?
  sha              String?
  prNumber         Int?
  prTitle          String?
  author           String?
  htmlUrl          String?
  message          String?  @db.Text
  summary          Json?
  githubDeliveryId String?
  createdAt        DateTime @default(now())

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repo    GithubRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([repoId, createdAt])
  @@index([githubDeliveryId])
}

// ─── Per-task GitHub links (PRs, commits, etc.) ───────────────

model TaskGithubLink {
  id           String   @id @default(cuid())
  taskId       String
  url          String   @db.VarChar(500)
  type         String
  title        String?
  status       String?
  author       String?
  number       Int?
  sha          String?
  repoFullName String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, url])
  @@index([taskId])
}

// ─── Calendar & Scheduling ─────────────────────────────────

enum ScheduleType {
  MEETING
  TRAINING
  REVIEW
  REMINDER
  OTHER
}

enum NotificationTriggerType {
  SCHEDULE_1DAY
  SCHEDULE_15MIN
  TASK_DEADLINE_1DAY
  TASK_DEADLINE_15MIN
}

enum ScheduleAttendeeResponse {
  PENDING
  ACCEPTED
  DECLINED
}

model Schedule {
  id          String       @id @default(cuid())
  title       String       @db.VarChar(100)
  type        ScheduleType
  scheduledAt DateTime
  endAt       DateTime?
  details     String?      @db.VarChar(2000)
  location    String?
  projectId   String?
  creatorId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  creator          User                      @relation(fields: [creatorId], references: [id])
  project          Project?                  @relation(fields: [projectId], references: [id])
  attendees        ScheduleAttendee[]
  notificationLogs ScheduleNotificationLog[]

  @@index([creatorId, scheduledAt])
  @@index([projectId, scheduledAt])
}

model ScheduleAttendee {
  id         String                   @id @default(cuid())
  scheduleId String
  userId     String?
  email      String
  name       String?
  response   ScheduleAttendeeResponse @default(PENDING)

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, email])
}

model ScheduleNotificationLog {
  id         String                  @id @default(cuid())
  scheduleId String?
  taskId     String?
  userId     String
  type       NotificationTriggerType
  sentAt     DateTime                @default(now())

  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, userId, type])
  @@unique([taskId, userId, type])
  @@index([scheduleId])
  @@index([taskId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String // "PAGE_VIEW", "CLICK", "ERROR"
  pageUrl   String?
  elementId String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
}

// ─── File System ───────────────────────────────

enum FileType {
  FILE
  FOLDER
}

model FileNode {
  id        String   @id @default(cuid())
  userId    String
  parentId  String?
  name      String
  type      FileType
  mimeType  String?
  size      Int?
  fileUrl   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      FileNode?        @relation("FolderChildren", fields: [parentId], references: [id])
  children    FileNode[]       @relation("FolderChildren")
  attachments TaskAttachment[]

  @@index([userId])
  @@index([parentId])
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  fileNodeId String
  createdAt  DateTime @default(now())

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileNode FileNode @relation(fields: [fileNodeId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([fileNodeId])
}
