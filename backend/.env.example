# ───────────────────────────────────────────────────────────────
# Backend environment example. Copy to .env and fill in real values.
# Never commit a populated .env to git.
# ───────────────────────────────────────────────────────────────

# Database (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# Redis (Rate Limiting) — optional.
# Leave blank to use in-memory rate limiting (fine for single-instance / dev).
# Set to a real Redis URL in production (multi-instance deployments).
# Examples:
#   Upstash:     rediss://<user>:<pass>@<host>.upstash.io:6379
#   Redis Cloud: redis://:<pass>@<host>.cloud.redislabs.com:12345
#   Self-hosted: redis://localhost:6379
REDIS_URL=""

# Auth secrets — generate fresh 32+ byte random values (base64)
JWT_SECRET=""
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Server
PORT=3000
NODE_ENV=development
# Slow-request logging threshold (ms)
SLOW_REQUEST_MS=1500

# Frontend (used for redirect URLs, email links, CORS)
FRONTEND_URL="http://localhost:5173"

# Admin seed (Phase 1.2) — leave blank to skip seeding entirely
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# ── Google OAuth ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── GitHub App / OAuth ──────────────────────────────────────────
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_INSTALLATION_URL=""

# OAuth credentials for the GitHub App
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# Legacy duplicates (kept for backward compat, may be removed once code uses GITHUB_OAUTH_*)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Email (Brevo HTTP API) ──────────────────────────────────────
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME=""

# ── Cloudinary (file uploads) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Gemini AI (admin diagnose) ──────────────────────────────────
GEMINI_API_KEY=""
# Optional Cloudflare Worker proxy URL (no trailing slash)
GEMINI_PROXY_URL=""

# Optional: enable Prisma query logging
PRISMA_QUERY_LOG=false
DATABASE_URL="mysql://root:Jenacute1109@localhost:3306/taskmanager"